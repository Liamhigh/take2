# Example environment variables — do NOT store secrets in repo.
# For CI, put the service account JSON into a GitHub Secret and reference it there.

# Firebase
FIREBASE_PROJECT_ID=my-app-production
FIREBASE_CLIENT_EMAIL=service-account@my-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional: runtime env
NODE_ENV=development
