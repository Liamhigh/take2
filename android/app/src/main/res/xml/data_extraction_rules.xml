<?xml version="1.0" encoding="utf-8"?>
<!--
    Data Extraction Rules for Android 12+
    
    Constitutional Requirements:
    - No cloud backup
    - All data stays local
    - Stateless operation
-->
<data-extraction-rules>
    <!-- Disallow cloud backup completely -->
    <cloud-backup>
        <!-- Nothing is backed up to cloud -->
    </cloud-backup>
    
    <!-- Allow device-to-device transfer for user convenience only -->
    <device-transfer>
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
