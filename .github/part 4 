package com.verumomnis.ui

import android.net.Uri
import android.os.Bundle
import android.view.LayoutInflater
import android.view.View
import android.view.ViewGroup
import androidx.activity.result.contract.ActivityResultContracts
import androidx.fragment.app.Fragment
import androidx.fragment.app.viewModels
import com.verumomnis.databinding.FragmentEvidenceUploadBinding

class EvidenceUploadFragment : Fragment() {
    private var _binding: FragmentEvidenceUploadBinding? = null
    private val binding get() = _binding!!
    private val viewModel: EvidenceUploadViewModel by viewModels()
    
    private val filePickerLauncher = registerForActivityResult(
        ActivityResultContracts.OpenMultipleDocuments()
    ) { uris: List<Uri>? ->
        uris?.let { viewModel.processSelectedFiles(it) }
    }
    
    override fun onCreateView(
        inflater: LayoutInflater,
        container: ViewGroup?,
        savedInstanceState: Bundle?
    ): View {
        _binding = FragmentEvidenceUploadBinding.inflate(inflater, container, false)
        return binding.root
    }
    
    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
        super.onViewCreated(view, savedInstanceState)
        
        binding.selectFilesButton.setOnClickListener {
            openFilePicker()
        }
        
        viewModel.uiState.observe(viewLifecycleOwner) { state ->
            when (state) {
                is EvidenceUploadState.Idle -> {
                    binding.progressBar.visibility = View.GONE
                    binding.statusText.text = "Select evidence files to begin analysis"
                }
                is EvidenceUploadState.Processing -> {
                    binding.progressBar.visibility = View.VISIBLE
                    binding.statusText.text = "Processing ${state.fileCount} files..."
                }
                is EvidenceUploadState.Success -> {
                    binding.progressBar.visibility = View.GONE
                    binding.statusText.text = "Analysis complete. ${state.findingsCount} findings detected."
                }
                is EvidenceUploadState.Error -> {
                    binding.progressBar.visibility = View.GONE
                    binding.statusText.text = "Error: ${state.message}"
                }
            }
        }
    }
    
    private fun openFilePicker() {
        filePickerLauncher.launch(arrayOf(
            "application/pdf",
            "image/*",
            "audio/*",
            "text/plain",
            "application/zip"
        ))
    }
    
    override fun onDestroyView() {
        super.onDestroyView()
        _binding = null
    }
}
