class PDFGenerator {
    fun generateReport(analysisResults: List<BrainResult>): SealedReport {
        val baos = ByteArrayOutputStream()
        val writer = PdfWriter(baos)
        val pdfDoc = PdfDocument(writer).apply {
            setPdfVersion(PdfVersion.PDF_1_7)
        }
        
        val document = Document(pdfDoc).apply {
            add(createHeader())
            add(createWatermark())
            add(createAnalysisContent(analysisResults))
            add(createFooter())
        }
        
        document.close()
        
        return SealedReport(baos.toByteArray(), Constitution.SHA512)
    }
    
